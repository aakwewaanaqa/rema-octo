{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Octo Pipeline",
  "scopeName": "source.octo-pipeline",
  "patterns": [
    { "include": "#comment" },
    { "include": "#loop-block" },
    { "include": "#regex-instruction" },
    { "include": "#nav-instruction" },
    { "include": "#scope-instruction" },
    { "include": "#until-instruction" },
    { "include": "#pipe-operator" },
    { "include": "#modifier" },
    { "include": "#var-instruction" },
    { "include": "#instruction" },
    { "include": "#string" },
    { "include": "#boolean" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.octo-pipeline",
      "match": "#.*$"
    },
    "loop-block": {
      "name": "meta.block.loop.octo-pipeline",
      "begin": "(loop)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.loop.octo-pipeline" },
        "2": { "name": "punctuation.section.block.begin.octo-pipeline" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.octo-pipeline" }
      },
      "patterns": [
        { "include": "#loop-block" },
        { "include": "#regex-instruction" },
        { "include": "#nav-instruction" },
        { "include": "#scope-instruction" },
        { "include": "#until-instruction" },
        { "include": "#pipe-operator" },
        { "include": "#modifier" },
        { "include": "#var-instruction" },
        { "include": "#instruction" },
        { "include": "#string" },
        { "include": "#boolean" }
      ]
    },
    "scope-instruction": {
      "match": "\\b(scope)\\b\\s+('[^']*'|[^\\s:'|]+)\\s+('[^']*'|[^\\s:'|]+)",
      "captures": {
        "1": { "name": "entity.name.function.octo-pipeline" },
        "2": { "name": "string.unquoted.bracket.octo-pipeline" },
        "3": { "name": "string.unquoted.bracket.octo-pipeline" }
      }
    },
    "until-instruction": {
      "match": "\\b(until)\\b\\s+('[^']*'|[^\\s:'|]+)",
      "captures": {
        "1": { "name": "entity.name.function.octo-pipeline" },
        "2": { "name": "string.unquoted.delimiter.octo-pipeline" }
      }
    },
    "pipe-operator": {
      "match": "\\|>",
      "name": "keyword.operator.pipe.octo-pipeline"
    },
    "regex-instruction": {
      "name": "meta.instruction.regex.octo-pipeline",
      "begin": "\\b(regex)\\b((:)(keep))?\\s+(')",
      "beginCaptures": {
        "1": { "name": "entity.name.function.octo-pipeline" },
        "3": { "name": "punctuation.separator.modifier.octo-pipeline" },
        "4": { "name": "storage.modifier.octo-pipeline" },
        "5": { "name": "punctuation.definition.string.begin.octo-pipeline" }
      },
      "end": "'",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.octo-pipeline" }
      },
      "patterns": [
        { "include": "source.js.regexp" }
      ]
    },
    "var-instruction": {
      "match": "\\b(var)\\b\\s+('([^']*)')",
      "captures": {
        "1": { "name": "entity.name.function.octo-pipeline" },
        "2": { "name": "entity.name.variable.octo-pipeline" }
      }
    },
    "nav-instruction": {
      "name": "meta.instruction.nav.octo-pipeline",
      "begin": "\\$",
      "beginCaptures": {
        "0": { "name": "keyword.operator.navigation.octo-pipeline" }
      },
      "end": "(?=\\s|\\|>|\\}|$)",
      "patterns": [
        {
          "match": "\\^",
          "name": "keyword.operator.navigation.octo-pipeline"
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.navigation.octo-pipeline"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.octo-pipeline"
        },
        {
          "match": "\\d+",
          "name": "constant.numeric.octo-pipeline"
        }
      ]
    },
    "modifier": {
      "match": "(:)([A-Za-z0-9_-]+)",
      "captures": {
        "1": { "name": "punctuation.separator.modifier.octo-pipeline" },
        "2": { "name": "storage.modifier.octo-pipeline" }
      }
    },
    "instruction": {
      "match": "\\b(scope|eat|word|space|line|var|regex|until)\\b",
      "name": "entity.name.function.octo-pipeline"
    },
    "string": {
      "name": "string.quoted.single.octo-pipeline",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.octo-pipeline"
        }
      ]
    },
    "boolean": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.octo-pipeline"
    }
  }
}
